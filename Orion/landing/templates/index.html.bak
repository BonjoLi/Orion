<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Cosmos Home</title>
    <meta name="color-scheme" content="dark">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Michroma&amp;family=Orbitron:wght@600;800&amp;display=swap" rel="stylesheet">
    <style>
        :root {
            box-sizing: border-box;
            padding-top: env(safe-area-inset-top, 0px);
            padding-bottom: env(safe-area-inset-bottom, 0px);
            --ink: #eaf0ff;
            --muted: #9fb0d8;
            --glow: #8fb4ff;
            --panel: rgba(10, 14, 34, .88);
            --rail: 76px;
            --railOpen: 250px;
            --limb: 30vh;
            --display: "Orbitron", "Trebuchet MS", "Segoe UI", system-ui, sans-serif;
            --wordmark: "Michroma", "Orbitron", "Trebuchet MS", system-ui, sans-serif
        }

        html {
            scroll-padding-top: env(safe-area-inset-top, 0px);
            height: 100%
        }

        *,
        *::before,
        *::after {
            box-sizing: inherit
        }

        body {
            margin: 0;
            height: 100%;
            overflow: hidden;
            color: var(--ink);
            font-family: "Trebuchet MS", "Segoe UI", system-ui, sans-serif;
            background:
                /* horizon haze: the sky brightens as it meets the planet */
                radial-gradient(130% 62% at 50% calc(100% - var(--limb) + 6vh), rgba(150, 205, 255, .4) 0, rgba(70, 140, 240, .2) 26%, rgba(20, 54, 140, .08) 50%, rgba(20, 54, 140, 0) 74%),
                /* nebulae */
                radial-gradient(48% 34% at 12% 14%, rgba(126, 84, 232, .2), rgba(126, 84, 232, 0) 72%),
                radial-gradient(44% 30% at 88% 26%, rgba(38, 178, 208, .15), rgba(38, 178, 208, 0) 72%),
                /* sky at the horizon fading up into deep space */
                linear-gradient(180deg, #01010a 0, #02040f 22%, #040a24 44%, #071337 64%, #0b2058 80%, #123a80 94%, #1a4f9d 100%)
        }

        #stars {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 0
        }

        /* Logo */
        #logo {
            position: fixed;
            z-index: 30;
            top: calc(14px + env(safe-area-inset-top, 0px));
            left: 9px;
            width: 58px;
            height: 58px;
            padding: 0;
            border: 0;
            border-radius: 50%;
            background: rgba(20, 26, 60, .6);
            cursor: pointer;
            filter: brightness(.7);
            transition: filter .3s, box-shadow .3s
        }

        #logo:hover {
            filter: brightness(.9)
        }

        #logo.on {
            filter: brightness(1.4) drop-shadow(0 0 8px var(--glow));
            box-shadow: 0 0 22px rgba(143, 180, 255, .55)
        }

        #logo svg {
            width: 100%;
            height: 100%
        }

        #logo:focus-visible,
        .nav a:focus-visible,
        .btn:focus-visible,
        .cta:focus-visible {
            outline: 2px solid #fff;
            outline-offset: 3px
        }

        /* Sidebar: always-visible icon rail; expands to icon + title on hover/focus/toggle and overlays the page
   instead of reflowing it (the page only ever reserves the collapsed rail width) */
        #menu {
            position: fixed;
            z-index: 20;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--rail);
            padding: calc(90px + env(safe-area-inset-top, 0px)) 16px 24px;
            background: var(--panel);
            border-right: 1px solid rgba(143, 180, 255, .25);
            backdrop-filter: blur(8px);
            overflow-x: hidden;
            overflow-y: auto;
            box-shadow: 12px 0 34px rgba(3, 5, 16, 0);
            transition: width .3s ease .12s, box-shadow .3s ease .12s
        }

        #menu:hover,
        #menu:focus-within,
        #menu.open {
            width: min(var(--railOpen), 80vw);
            box-shadow: 12px 0 34px rgba(3, 5, 16, .6);
            transition: width .25s ease, box-shadow .25s ease
        }

        /* the logo is not inside #menu, so hovering it counts as hovering the sidebar */
        body:has(#logo:hover) #menu,
        body:has(#logo:focus-visible) #menu {
            width: min(var(--railOpen), 80vw);
            box-shadow: 12px 0 34px rgba(3, 5, 16, .6);
            transition: width .25s ease, box-shadow .25s ease
        }

        .nav {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            gap: 6px
        }

        .nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: 10px;
            color: var(--ink);
            text-decoration: none;
            letter-spacing: .04em;
            white-space: nowrap
        }

        .nav a:hover {
            background: rgba(143, 180, 255, .16)
        }

        .nav .ico {
            flex: 0 0 auto;
            width: 22px;
            height: 22px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round
        }

        .nav .ico .fill {
            fill: currentColor;
            stroke: none
        }

        .nav a span,
        #menu small {
            opacity: 0;
            transition: opacity .18s ease
        }

        #menu:hover .nav a span,
        #menu:hover small,
        #menu:focus-within .nav a span,
        #menu:focus-within small,
        #menu.open .nav a span,
        #menu.open small {
            opacity: 1
        }

        body:has(#logo:hover) #menu .nav a span,
        body:has(#logo:hover) #menu small {
            opacity: 1
        }

        #menu small {
            display: block;
            margin: 0 0 10px 12px;
            color: var(--muted);
            letter-spacing: .2em;
            text-transform: uppercase;
            font-size: 11px;
            white-space: nowrap
        }

        /* Landing hero: centred wordmark + CTA, floating above the planet's limb */
        main {
            position: relative;
            z-index: 5;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            /* rail-width padding on both sides keeps the hero centred on the viewport, clear of the sidebar */
            padding: clamp(40px, 6vh, 64px) var(--rail)
        }

        .title-wrap {
            position: relative;
            line-height: 0
        }

        .wordmark {
            font-family: var(--wordmark);
            font-size: clamp(26px, min(11vw, 15vh), 144px);
            font-weight: 400;
            line-height: 1.05;
            letter-spacing: .16em;
            margin-right: -.16em;
            color: #fff;
            text-shadow: 0 0 5px rgba(255, 255, 255, .55), 0 0 18px rgba(155, 205, 255, .7), 0 0 44px rgba(70, 130, 240, .55)
        }

        .spark {
            position: absolute;
            background: radial-gradient(circle, #fff 0 20%, #cfe3ff 42%, rgba(160, 200, 255, 0) 74%);
            clip-path: polygon(50% 0, 56% 44%, 100% 50%, 56% 56%, 50% 100%, 44% 56%, 0 50%, 44% 44%);
            animation: twinkle 5.4s ease-in-out infinite
        }

        .spark.a {
            left: -5%;
            top: -24%;
            width: clamp(14px, 2vw, 26px);
            aspect-ratio: 1
        }

        .spark.b {
            right: -4%;
            top: 2%;
            width: clamp(9px, 1.3vw, 16px);
            aspect-ratio: 1;
            animation-delay: -1.9s
        }

        .spark.c {
            left: 20%;
            bottom: -26%;
            width: clamp(8px, 1.1vw, 13px);
            aspect-ratio: 1;
            animation-delay: -3.3s
        }

        @keyframes twinkle {

            0%,
            100% {
                opacity: .45;
                transform: scale(.85)
            }

            50% {
                opacity: 1;
                transform: scale(1.08)
            }
        }

        .cta {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin-top: clamp(14px, 2.8vh, 32px);
            padding: clamp(12px, 1.7vh, 17px) clamp(26px, 3.2vw, 44px);
            border: 1px solid rgba(186, 219, 255, .6);
            border-radius: 999px;
            color: #f2f7ff;
            font-family: var(--display);
            font-size: clamp(12px, 1.2vw, 15px);
            font-weight: 600;
            letter-spacing: .26em;
            text-transform: uppercase;
            text-decoration: none;
            background: linear-gradient(180deg, rgba(163, 203, 255, .34), rgba(64, 116, 226, .26));
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .35), 0 12px 34px rgba(28, 66, 168, .5), 0 0 30px rgba(110, 170, 255, .4);
            backdrop-filter: blur(6px);
            transition: transform .25s ease, box-shadow .25s ease, background .25s ease
        }

        .cta:hover,
        .cta:focus-visible {
            transform: translateY(-2px);
            background: linear-gradient(180deg, rgba(190, 222, 255, .48), rgba(76, 132, 244, .34));
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .5), 0 16px 42px rgba(28, 66, 168, .55), 0 0 46px rgba(140, 190, 255, .6)
        }

        .cta .ico-star {
            width: 1.15em;
            height: 1.15em;
            fill: #dcebff;
            filter: drop-shadow(0 0 6px rgba(190, 225, 255, .8))
        }

        h1 {
            position: absolute;
            top: calc(26px + env(safe-area-inset-top, 0px));
            left: 0;
            right: 0;
            text-align: center;
            /* cancels the trailing letter-space so the caption centres on the same axis as the wordmark */
            margin: 0 -.35em 0 0;
            font-weight: 300;
            letter-spacing: .35em;
            font-size: clamp(14px, 2.2vw, 22px);
            text-transform: uppercase;
            color: var(--muted);
            pointer-events: none
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: clamp(12px, 3vw, 40px);
            max-width: 880px;
            width: 100%
        }

        .btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            color: var(--ink);
            text-decoration: none;
            font-size: clamp(12px, 1.6vw, 16px);
            letter-spacing: .12em;
            text-transform: uppercase;
            animation: bob 6s ease-in-out infinite
        }

        .btn:nth-child(2) {
            animation-delay: -1.5s
        }

        .btn:nth-child(3) {
            animation-delay: -3s
        }

        .btn:nth-child(4) {
            animation-delay: -4.5s
        }

        .btn svg {
            width: 100%;
            max-width: 150px;
            height: auto;
            overflow: visible;
            transition: transform .3s, filter .3s
        }

        .btn:hover svg,
        .btn:focus-visible svg {
            transform: scale(1.14);
            filter: drop-shadow(0 0 14px var(--glow))
        }

        @keyframes bob {
            50% {
                transform: translateY(-10px)
            }
        }

        @media(max-width:620px) {
            .grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 26px 12px;
                max-width: 340px
            }
        }

        @media(max-height:620px) {
            .wordmark {
                font-size: min(11vw, 13vh)
            }

            .cta {
                margin-top: 14px;
                padding-top: 10px;
                padding-bottom: 10px
            }
        }

        @media(prefers-reduced-motion:reduce) {

            .btn,
            .spark,
            .aurora,
            .comet,
            .meteor,
            .sat,
            .constellation .tw {
                animation: none
            }

            #menu {
                transition: none
            }
        }

        /* Sky: astronomical backdrop for the outward view */
        .sky {
            position: fixed;
            inset: 0;
            z-index: 1;
            overflow: hidden;
            pointer-events: none
        }

        .milkyway {
            position: absolute;
            left: -15%;
            top: -14%;
            width: 130%;
            height: 76%;
            transform: rotate(-17deg);
            background: linear-gradient(180deg, rgba(150, 175, 255, 0) 24%, rgba(150, 175, 255, .07) 40%, rgba(216, 208, 255, .13) 50%, rgba(150, 175, 255, .07) 60%, rgba(150, 175, 255, 0) 76%);
            filter: blur(24px)
        }

        .nebula {
            position: absolute;
            border-radius: 50%;
            opacity: .8;
            filter: blur(46px)
        }

        .nebula.a {
            left: 2vw;
            top: 3vh;
            width: 40vw;
            height: 30vh;
            background: radial-gradient(circle at 42% 42%, rgba(150, 96, 255, .3), rgba(66, 38, 168, .16) 48%, rgba(66, 38, 168, 0) 72%)
        }

        .nebula.b {
            right: 1vw;
            bottom: 20vh;
            width: 34vw;
            height: 24vh;
            background: radial-gradient(circle at 58% 50%, rgba(58, 200, 218, .2), rgba(28, 78, 178, .12) 50%, rgba(28, 78, 178, 0) 74%)
        }

        .moon {
            position: absolute;
            top: 8vh;
            right: 9vw;
            width: clamp(62px, 7.6vw, 118px);
            filter: drop-shadow(0 0 16px rgba(255, 246, 224, .45)) drop-shadow(0 0 52px rgba(178, 208, 255, .28))
        }

        .moon svg,
        .sat svg {
            display: block;
            width: 100%;
            height: auto
        }

        .planet {
            position: absolute;
            top: 25vh;
            left: 7vw;
            width: clamp(34px, 4.2vw, 66px);
            aspect-ratio: 1;
            border-radius: 50%;
            background: radial-gradient(circle at 34% 30%, #ffe9bd 0, #dda963 52%, #7c5a2c 100%);
            box-shadow: 0 0 24px rgba(255, 218, 158, .35)
        }

        .planet::after {
            content: "";
            position: absolute;
            left: 50%;
            top: 50%;
            width: 250%;
            height: 64%;
            border: 2px solid rgba(255, 230, 182, .7);
            border-radius: 50%;
            transform: translate(-50%, -50%) rotate(-19deg);
            box-shadow: 0 0 0 4px rgba(255, 230, 182, .12)
        }

        .constellation {
            position: absolute;
            left: 10vw;
            top: 9vh;
            width: clamp(140px, 18vw, 280px);
            height: auto;
            opacity: .85
        }

        .constellation .tw {
            animation: twinkle 4.6s ease-in-out infinite
        }

        .comet {
            position: absolute;
            top: 14vh;
            right: 27vw;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: radial-gradient(circle, #fff 0 30%, #bfe4ff 62%, rgba(150, 200, 255, 0) 100%);
            box-shadow: 0 0 14px 4px rgba(170, 215, 255, .55);
            opacity: .9;
            animation: comet 20s ease-in-out infinite
        }

        .comet::after {
            content: "";
            position: absolute;
            left: 5px;
            top: 50%;
            width: clamp(110px, 15vw, 230px);
            height: 13px;
            transform: translateY(-50%) rotate(-16deg);
            transform-origin: 0 50%;
            background: linear-gradient(90deg, rgba(205, 235, 255, .8) 0, rgba(150, 200, 255, .3) 42%, rgba(120, 170, 255, 0) 100%);
            clip-path: polygon(0 42%, 100% 0, 100% 100%, 0 58%);
            filter: blur(1px)
        }

        @keyframes comet {

            0%,
            100% {
                opacity: .85;
                transform: translate(0, 0)
            }

            50% {
                opacity: 1;
                transform: translate(-1.6vw, 1.4vh)
            }
        }

        .meteor {
            position: absolute;
            width: 3px;
            height: 3px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 0 10px 3px rgba(200, 230, 255, .8);
            opacity: 0;
            animation: meteor 8s linear infinite
        }

        .meteor::after {
            content: "";
            position: absolute;
            left: 0;
            top: 50%;
            width: clamp(80px, 11vw, 170px);
            height: 2px;
            transform: translateY(-50%) rotate(-22deg);
            transform-origin: 0 50%;
            background: linear-gradient(90deg, rgba(255, 255, 255, .95) 0, rgba(190, 225, 255, .45) 38%, rgba(150, 190, 255, 0) 100%)
        }

        .meteor.a {
            top: 11vh;
            right: 31vw
        }

        .meteor.b {
            top: 32vh;
            right: 5vw;
            animation-delay: 3.6s;
            animation-duration: 10s
        }

        .meteor.c {
            top: 44vh;
            left: 33vw;
            animation-delay: 6.2s;
            animation-duration: 12s
        }

        @keyframes meteor {
            0% {
                opacity: 0;
                transform: translate(0, 0)
            }

            4% {
                opacity: 1
            }

            24% {
                opacity: .95
            }

            36%,
            100% {
                opacity: 0;
                transform: translate(-27vw, 16vh)
            }
        }

        .sat {
            position: absolute;
            top: 33vh;
            left: -16vw;
            width: clamp(38px, 4.4vw, 66px);
            filter: drop-shadow(0 0 12px rgba(150, 200, 255, .5));
            animation: satPass 54s linear infinite
        }

        .sat svg {
            transform: rotate(-14deg)
        }

        @keyframes satPass {
            from {
                transform: translate3d(0, 0, 0)
            }

            to {
                transform: translate3d(136vw, -9vh, 0)
            }
        }

        /* Planet limb: cinematic view outward from orbit.
   The disk is far wider than the viewport so only its sunlit upper arc shows. */
        .horizon {
            position: fixed;
            inset: 0;
            z-index: 4;
            overflow: hidden;
            pointer-events: none
        }

        .aurora {
            position: absolute;
            left: -12%;
            right: -12%;
            top: calc(100% - var(--limb) - 13vh);
            height: 14vh;
            background: linear-gradient(180deg, rgba(70, 240, 190, 0) 0, rgba(70, 240, 190, .18) 46%, rgba(120, 250, 225, .3) 76%, rgba(120, 250, 225, 0) 100%);
            opacity: .75;
            filter: blur(22px);
            -webkit-mask-image: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0) 0 4%, #000 8% 14%, rgba(0, 0, 0, 0) 18% 22%);
            mask-image: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0) 0 4%, #000 8% 14%, rgba(0, 0, 0, 0) 18% 22%);
            animation: aurora 16s ease-in-out infinite alternate
        }

        @keyframes aurora {
            from {
                opacity: .5;
                transform: translateY(1.4vh) scaleY(.88)
            }

            to {
                opacity: .95;
                transform: translateY(-1.4vh) scaleY(1.08)
            }
        }

        .earth {
            position: absolute;
            left: 50%;
            top: calc(100% - var(--limb));
            width: max(280vw, 320vh);
            height: max(280vw, 320vh);
            border-radius: 50%;
            transform: translateX(-50%);
            background:
                /* sunlight raking across the day side */
                radial-gradient(56vw 30vh at calc(50% + 22vw) 4vh, rgba(210, 240, 255, .55), rgba(130, 195, 255, .18) 46%, rgba(130, 195, 255, 0) 76%),
                /* terminator: the night side falls away */
                radial-gradient(66vw 26vh at calc(50% - 26vw) 4vh, rgba(2, 6, 20, .8), rgba(2, 6, 20, .3) 46%, rgba(2, 6, 20, 0) 74%),
                /* cloud systems */
                radial-gradient(24vw 10vh at calc(50% + 10vw) 5vh, rgba(255, 255, 255, .26), rgba(255, 255, 255, 0) 70%),
                radial-gradient(30vw 12vh at calc(50% - 6vw) 10vh, rgba(230, 245, 255, .22), rgba(230, 245, 255, 0) 72%),
                radial-gradient(18vw 8vh at calc(50% + 30vw) 3vh, rgba(255, 255, 255, .2), rgba(255, 255, 255, 0) 70%),
                /* city lights on the night side */
                radial-gradient(2px 2px at calc(50% - 27vw) 6vh, rgba(255, 214, 148, .9), rgba(255, 214, 148, 0) 60%),
                radial-gradient(2px 2px at calc(50% - 23vw) 9vh, rgba(255, 206, 140, .85), rgba(255, 206, 140, 0) 60%),
                radial-gradient(2px 2px at calc(50% - 18vw) 13vh, rgba(255, 222, 160, .9), rgba(255, 222, 160, 0) 60%),
                radial-gradient(2px 2px at calc(50% - 25vw) 17vh, rgba(255, 200, 130, .8), rgba(255, 200, 130, 0) 60%),
                radial-gradient(2px 2px at calc(50% - 14vw) 21vh, rgba(255, 216, 150, .85), rgba(255, 216, 150, 0) 60%),
                radial-gradient(2px 2px at calc(50% - 20vw) 25vh, rgba(255, 208, 142, .75), rgba(255, 208, 142, 0) 60%),
                radial-gradient(2px 2px at calc(50% - 9vw) 8vh, rgba(255, 218, 155, .8), rgba(255, 218, 155, 0) 60%),
                radial-gradient(2px 2px at calc(50% - 31vw) 12vh, rgba(255, 204, 138, .7), rgba(255, 204, 138, 0) 60%),
                /* ocean and land, brightest at the limb */
                linear-gradient(180deg, #a6dcf5 0vh, #59a4dc 3vh, #2a6cae 7vh, #14457f 12vh, #08295a 21vh, #041634 34vh, #020818 60vh, #01030c 110vh);
            box-shadow: 0 -2px 6px rgba(214, 240, 255, .8), 0 -14px 44px rgba(120, 190, 255, .5), 0 -48px 130px rgba(60, 120, 250, .3)
        }

        .earth::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: radial-gradient(closest-side, rgba(150, 215, 255, 0) 99.05%, rgba(158, 220, 255, .95) 99.65%, rgba(150, 215, 255, 0) 100%);
            filter: blur(3px)
        }

        .ground {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 14vh;
            background: linear-gradient(180deg, rgba(3, 10, 26, 0) 0, rgba(3, 10, 26, .5) 45%, #020816 100%)
        }

        .atmo {
            position: absolute;
            inset: 0;
            background: radial-gradient(125% 32vh at 50% calc(100% - var(--limb) + 6px), rgba(160, 210, 255, .3) 0, rgba(84, 152, 255, .16) 36%, rgba(40, 90, 220, .05) 58%, rgba(40, 90, 220, 0) 76%);
            filter: blur(16px)
        }
    </style>
</head>

<body>
    <canvas id="stars" aria-hidden="true"></canvas>

    <!-- Logo: replace the SVG with your own logo image/markup -->
    <button id="logo" aria-label="Toggle menu" aria-expanded="false" aria-controls="menu">
        <svg viewBox="0 0 60 60" fill="none" stroke="#cfe0ff" stroke-width="2.5" stroke-linecap="round">
            <circle cx="30" cy="30" r="9" fill="#cfe0ff" stroke="none" />
            <ellipse cx="30" cy="30" rx="22" ry="8" transform="rotate(-25 30 30)" />
            <circle cx="48" cy="21" r="2.5" fill="#cfe0ff" stroke="none" />
        </svg>
    </button>

    <nav id="menu" aria-label="Main menu">
        <small>Navigate</small>
        <ul class="nav">
            <!-- Swap these hrefs for real pages later -->
            <li><a href="#home">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3.5 11 12 4.2 20.5 11" />
                        <path d="M5.8 10v9.6h12.4V10" />
                        <path d="M10.2 19.6v-4.9h3.6v4.9" />
                    </svg>
                    <span>Home</span></a></li>
            <li><a href="#map">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M2 6 8.5 3l7 3.5L22 3v14.5L15.5 21l-7-3.5L2 21Z" />
                        <path d="M8.5 3v14.5M15.5 6.5V21" />
                    </svg>
                    <span>Map</span></a></li>
            <li><a href="#database">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                        <ellipse cx="12" cy="5.5" rx="8.5" ry="3" />
                        <path d="M3.5 5.5v13c0 1.7 3.8 3 8.5 3s8.5-1.3 8.5-3v-13" />
                        <path d="M3.5 12c0 1.7 3.8 3 8.5 3s8.5-1.3 8.5-3" />
                    </svg>
                    <span>Database</span></a></li>
            <li><a href="#live">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                        <circle class="fill" cx="12" cy="12" r="2.2" />
                        <path d="M7.9 7.9a5.8 5.8 0 0 0 0 8.2M16.1 7.9a5.8 5.8 0 0 1 0 8.2" />
                        <path d="M4.8 4.8a10.2 10.2 0 0 0 0 14.4M19.2 4.8a10.2 10.2 0 0 1 0 14.4" />
                    </svg>
                    <span>Live</span></a></li>
            <li><a href="#account">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="7.5" r="4" />
                        <path d="M19.5 20.5v-1a4 4 0 0 0-4-4h-7a4 4 0 0 0-4 4v1" />
                    </svg>
                    <span>Account</span></a></li>
            <li><a href="#about">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 11.2v5.4" />
                        <circle class="fill" cx="12" cy="7.9" r="1.2" />
                    </svg>
                    <span>About</span></a></li>
        </ul>
    </nav>

    <h1>Welcome, Stargazer</h1>

    <main>
        <div class="title-wrap">
            <span class="spark a" aria-hidden="true"></span>
            <span class="spark b" aria-hidden="true"></span>
            <span class="spark c" aria-hidden="true"></span>
            <div class="wordmark">ORION</div>
        </div>

        <a class="cta" href="/map">
            <svg class="ico-star" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 1.4 14.4 8.6 21.6 11 14.4 13.4 12 20.6 9.6 13.4 2.4 11 9.6 8.6Z" />
            </svg>
            Get Started
        </a>
        <div class="grid">
            <!-- Center page buttons cleared for now. Uncomment to restore (swap the hrefs for real pages then):
    <a class="btn" href="#moon" aria-label="Moon">
      <svg viewBox="0 0 120 120"><defs><radialGradient id="mg" cx="35%" cy="30%"><stop offset="0" stop-color="#fffdf2"/><stop offset="1" stop-color="#a9a9b8"/></radialGradient></defs>
        <circle cx="60" cy="60" r="48" fill="url(#mg)"/><circle cx="42" cy="46" r="9" fill="#8f8fa3" opacity=".6"/><circle cx="78" cy="68" r="12" fill="#8f8fa3" opacity=".55"/><circle cx="52" cy="82" r="6" fill="#8f8fa3" opacity=".6"/><circle cx="82" cy="40" r="5" fill="#8f8fa3" opacity=".5"/></svg>
      <span>Moon</span></a>

    <a class="btn" href="#meteors" aria-label="Meteors and comets">
      <svg viewBox="0 0 120 120"><defs><linearGradient id="tg" x1="1" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#ffb347"/><stop offset="1" stop-color="#ffb347" stop-opacity="0"/></linearGradient>
        <linearGradient id="tg2" x1="1" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#9fd4ff"/><stop offset="1" stop-color="#9fd4ff" stop-opacity="0"/></linearGradient></defs>
        <path d="M92 28 L10 92 L18 100 Z" fill="url(#tg)" transform="translate(6,-4)"/><circle cx="98" cy="22" r="11" fill="#ffd38a"/>
        <path d="M110 62 L52 108 L58 112 Z" fill="url(#tg2)" opacity=".85"/><circle cx="108" cy="62" r="6" fill="#d7edff"/></svg>
      <span>Meteors</span></a>

    <a class="btn" href="#satellite" aria-label="Satellite">
      <svg viewBox="0 0 120 120" transform="rotate(-20)"><rect x="6" y="46" width="34" height="28" rx="2" fill="#2f5fd0" stroke="#cfe0ff" stroke-width="2"/><rect x="80" y="46" width="34" height="28" rx="2" fill="#2f5fd0" stroke="#cfe0ff" stroke-width="2"/>
        <path d="M23 46v28M14 46v28M32 46v28M97 46v28M88 46v28M106 46v28" stroke="#cfe0ff" stroke-width="1" opacity=".7"/><path d="M40 60h12M68 60h12" stroke="#cfe0ff" stroke-width="3"/>
        <rect x="50" y="46" width="20" height="28" rx="4" fill="#d9dde8" stroke="#fff" stroke-width="2"/><circle cx="60" cy="60" r="5" fill="#35406b"/><path d="M60 46V34" stroke="#cfe0ff" stroke-width="2"/><circle cx="60" cy="31" r="4" fill="#ff7a7a"/></svg>
      <span>Satellite</span></a>

    <a class="btn" href="#clouds" aria-label="Clouds">
      <svg viewBox="0 0 120 120"><defs><linearGradient id="cg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#b9c8ea"/></linearGradient></defs>
        <path d="M34 90a22 22 0 0 1-2-44 28 28 0 0 1 52-6 24 24 0 0 1 6 50z" fill="url(#cg)"/></svg>
      <span>Clouds</span></a>
    -->
        </div>
    </main>

    <!-- Sky: astronomical backdrop — moon, ringed planet, constellation, comet, meteors, ISS pass, nebulae -->
    <div class="sky" aria-hidden="true">
        <div class="milkyway"></div>
        <div class="nebula a"></div>
        <div class="nebula b"></div>

        <!-- Big Dipper keeping watch up north -->
        <svg class="constellation" viewBox="0 0 300 160">
            <g fill="none" stroke="#a9c6ff" stroke-opacity=".4" stroke-width="1">
                <path d="M26 40 18 92 96 86 86 34ZM96 86 146 108 198 74 246 40" />
            </g>
            <g fill="#eaf2ff">
                <circle class="tw" cx="26" cy="40" r="3" />
                <circle cx="18" cy="92" r="2.6" />
                <circle cx="96" cy="86" r="2.7" />
                <circle cx="86" cy="34" r="2.5" />
                <circle cx="146" cy="108" r="2.6" />
                <circle cx="198" cy="74" r="2.9" />
                <circle class="tw" cx="246" cy="40" r="2.4" />
            </g>
        </svg>

        <div class="moon">
            <svg viewBox="0 0 120 120">
                <defs>
                    <radialGradient id="moonGrad" cx="35%" cy="30%">
                        <stop offset="0" stop-color="#fffdf2" />
                        <stop offset="1" stop-color="#a9a9b8" />
                    </radialGradient>
                </defs>
                <circle cx="60" cy="60" r="48" fill="url(#moonGrad)" />
                <circle cx="42" cy="46" r="9" fill="#8f8fa3" opacity=".6" />
                <circle cx="78" cy="68" r="12" fill="#8f8fa3" opacity=".55" />
                <circle cx="52" cy="82" r="6" fill="#8f8fa3" opacity=".6" />
                <circle cx="82" cy="40" r="5" fill="#8f8fa3" opacity=".5" />
            </svg>
        </div>

        <div class="planet"></div>
        <div class="comet"></div>
        <div class="meteor a"></div>
        <div class="meteor b"></div>
        <div class="meteor c"></div>

        <div class="sat">
            <svg viewBox="0 0 120 120">
                <rect x="6" y="46" width="34" height="28" rx="2" fill="#2f5fd0" stroke="#cfe0ff" stroke-width="2" />
                <rect x="80" y="46" width="34" height="28" rx="2" fill="#2f5fd0" stroke="#cfe0ff" stroke-width="2" />
                <path d="M23 46v28M14 46v28M32 46v28M97 46v28M88 46v28M106 46v28" stroke="#cfe0ff" stroke-width="1" opacity=".7" />
                <path d="M40 60h12M68 60h12" stroke="#cfe0ff" stroke-width="3" />
                <rect x="50" y="46" width="20" height="28" rx="4" fill="#d9dde8" stroke="#fff" stroke-width="2" />
                <circle cx="60" cy="60" r="5" fill="#35406b" />
                <path d="M60 46V34" stroke="#cfe0ff" stroke-width="2" />
                <circle cx="60" cy="31" r="4" fill="#ff7a7a" />
            </svg>
        </div>
    </div>

    <!-- Earth's limb: epic outward view from orbit — aurora, sunlit atmosphere, night-side city lights.
     The human silhouettes that used to stand on the horizon are gone; this is a view from space. -->
    <div class="horizon" aria-hidden="true">
        <div class="aurora"></div>
        <div class="earth"></div>
        <div class="ground"></div>
        <div class="atmo"></div>
    </div>

    <script>
        // Sidebar is always visible and starts collapsed; it expands on hover/focus. The logo button pins it
        // open (or closed) for touch and keyboard users, without affecting the page layout.
        const logo = document.getElementById('logo'), menu = document.getElementById('menu');
        function setMenu(o) { menu.classList.toggle('open', o); logo.classList.toggle('on', o); logo.setAttribute('aria-expanded', o) }
        logo.addEventListener('click', () => setMenu(!menu.classList.contains('open')));
        addEventListener('keydown', e => { if (e.key === 'Escape') setMenu(false) });

        // Twinkling starfield
        const c = document.getElementById('stars'), x = c.getContext('2d'); let S = [];
        function init() {
            const d = devicePixelRatio || 1; c.width = innerWidth * d; c.height = innerHeight * d; x.setTransform(d, 0, 0, d, 0, 0);
            S = Array.from({ length: Math.min(260, Math.floor(innerWidth * innerHeight / 5000)) }, () => ({ x: Math.random() * innerWidth, y: Math.random() * innerHeight, r: Math.random() * 1.3 + .2, p: Math.random() * 6.3, s: Math.random() * 1.5 + .4 }))
        }
        function draw(t) {
            x.clearRect(0, 0, innerWidth, innerHeight);
            for (const s of S) { x.globalAlpha = .35 + .65 * Math.abs(Math.sin(t / 1000 * s.s + s.p)); x.fillStyle = '#fff'; x.beginPath(); x.arc(s.x, s.y, s.r, 0, 6.3); x.fill() }
            if (!matchMedia('(prefers-reduced-motion:reduce)').matches) requestAnimationFrame(draw)
        }
        addEventListener('resize', init); init(); requestAnimationFrame(draw);
    </script>
</body>

</html>