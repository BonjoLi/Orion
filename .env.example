# Copy to .env.local (never commit .env.local)

# Google Maps (map page). Free "Maps Demo Key", no card:
#   https://console.cloud.google.com/google/maps-hosted/tos?ref=https://developers.google.com/maps/
# Production key (still $0 under 10k loads/month): Cloud console → Billing →
# APIs & Services → enable "Maps JavaScript API" + "Places API (New)" → Credentials.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Vector map ID. DEMO_MAP_ID works with the demo key; otherwise create one at
# Cloud console → Maps Management → Create map ID → JavaScript → Vector.
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID

# Required for /api/plan (the AI plan). Without it the route returns a
# deterministic fallback plan with confidence 0, so the map still works.
ANTHROPIC_API_KEY=

# Optional. MapLibre style for /map-legacy. OpenFreeMap is free, no key.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron

# Optional, later: MongoDB Atlas for a shared score cache (MLH track prize).
MONGODB_URI=

# --- Login backend (the Flask app in Orion/) ---
# Where the Next.js server finds Flask. The default is right when you run both on the same
# computer; change it only if Flask runs somewhere else. Server-side only: browsers never see it.
BACKEND_URL=http://127.0.0.1:8080
# Flask reads these from the environment (all optional):
#   ORION_SECRET_KEY    signs login cookies; defaults to "devs"
#   ORION_DATABASE_URI  defaults to sqlite:///db.sqlite3
#   FRONTEND_URL        where the map is, if someone opens Flask (port 8080) directly;
#                       defaults to the same host on port 3000
